# RuProbe — пример окружения. Скопируйте в .env и заполните.
#
# .env читает docker compose для подстановки ${...} в compose.yaml,
# а также pydantic-settings при локальном запуске бота.

# --- обязательно -------------------------------------------------------------
# Токен от @BotFather. Без него bot не стартует (проверяется на входе).
BOT_TOKEN=

# --- точка наблюдения --------------------------------------------------------
# По docs/tspu-model.md это первичный ключ измерения, а не метаданные:
# один и тот же ресурс штатно ведёт себя по-разному у разных операторов.
REGION=default
OPERATOR=default
OBSERVATION_NAME=local agent

# --- связь бота с агентом ----------------------------------------------------
# Внутри docker-сети — имя сервиса. Локально без docker: http://127.0.0.1:8080
AGENT_URL=http://agent:8080

# Общий дедлайн одной пробы.
AGENT_TIMEOUT_MS=5000
# Сколько ждать готовности задания и с какой частотой опрашивать агент.
POLL_INTERVAL_S=1.5
POLL_TIMEOUT_S=600
# Обновление черновика (черновик живёт 30 с, поэтому чаще).
DRAFT_INTERVAL_S=4
# Объём загрузки для зонда throughput: без него деградация capacity не видна.
THROUGHPUT_BYTES=1048576

# --- база --------------------------------------------------------------------
# Путь внутри контейнера бота (том ruprobe-data).
DB_PATH=/data/ruprobe.sqlite3

# --- агент (нужны только при запуске агента вне compose) ---------------------
AGENT_ADDR=:8080
AGENT_WORKERS=8
AGENT_JOB_TTL=10m
AGENT_DEFAULT_TIMEOUT=5s
AGENT_NEIGHBOR_LIMIT=16
AGENT_NEIGHBOR_SCOPE=/24
